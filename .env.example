# Скопіюйте у .env і за потреби змініть значення: cp .env.example .env
# Сам файл .env у репозиторій не потрапляє (.gitignore). Тут лише заглушки.

# JWT: SECRET_KEY — довгий випадковий рядок; ALGORITHM обов'язковий, типового значення в коді немає
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Postgres: значення збігаються із сервісом postgres у docker-compose.yml
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_NAME=wishlist_db
# prefer — SSL, якщо сервер його вміє; для хмарної бази: require; для контейнера можна disable
DB_SSLMODE=prefer

# Redis: redis:// — без TLS, rediss:// — із TLS
REDIS_URL=redis://localhost:6379

# Звідки дозволені запити з браузера (CORS), через кому
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
